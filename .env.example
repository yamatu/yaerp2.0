# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yaerp
POSTGRES_USER=yaerp
POSTGRES_PASSWORD=yaerp_secret_2024
# Set this when another local project already uses host port 5432.
POSTGRES_PUBLISHED_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=yaerp_minio
MINIO_SECRET_KEY=minio_secret_2024
MINIO_BUCKET=yaerp
MINIO_USE_SSL=false

# JWT
JWT_SECRET=yaerp-jwt-secret-change-me-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_HOURS=168

# Backend
BACKEND_PORT=8080
GIN_MODE=release

# Diagnostics (disabled by default; use a long random token in test only)
PPROF_ENABLED=false
PPROF_TOKEN=
# Maximum bytes accepted for any incoming request body
MAX_REQUEST_BYTES=67108864
# Maximum in-memory backup archive size (adjust for test data volume)
BACKUP_MAX_BYTES=268435456

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws
