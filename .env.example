# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yaerp
POSTGRES_USER=yaerp
POSTGRES_PASSWORD=yaerp_secret_2024
# Set this when another local project already uses host port 5432.
POSTGRES_PUBLISHED_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=8

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=yaerp_minio
MINIO_SECRET_KEY=minio_secret_2024
MINIO_BUCKET=yaerp
MINIO_USE_SSL=false

# JWT
JWT_SECRET=yaerp-jwt-secret-change-me-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_HOURS=168

# Authentication and browser origins
ALLOW_PUBLIC_REGISTRATION=false
# Set explicit production origins, separated by commas. Use * only for local development.
CORS_ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555,http://localhost:3000,http://127.0.0.1:3000

# Backend
BACKEND_PORT=8080
GIN_MODE=release

# Automatic PostgreSQL backups. BACKUP_HOST_DIR is a host-system path mounted
# into the backend container at BACKUP_DIRECTORY.
BACKUP_AUTO_ENABLED=false
BACKUP_HOST_DIR=./backups
BACKUP_DIRECTORY=/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_BYTES=268435456

# Optional diagnostics (keep disabled outside a controlled test network)
PPROF_ENABLED=false
PPROF_TOKEN=
MAX_REQUEST_BYTES=67108864

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# WhatsApp Web sidecar
WHATSAPP_SERVICE_URL=http://whatsapp:3010
WHATSAPP_INTERNAL_SECRET=replace-with-a-long-random-secret
WHATSAPP_MAX_MEDIA_BYTES=26214400

# XTLS / Mihomo outbound proxy core
# Disable to hide the proxy feature entirely.
MIHOMO_ENABLED=true
# Address the backend and the WhatsApp sidecar use to reach the core inside the
# docker network. Use 127.0.0.1:7890 when running the backend natively.
# Only the host part is taken from here: the port is managed on the proxy page
# ("代理端口") and stored in the database, defaulting to the port below.
# The backend probes the other variant automatically when this one is
# unreachable, so a stale value only costs one extra connection attempt.
MIHOMO_MIXED_ADDR=proxy:7890
# Mihomo external controller (REST API) endpoint. Use http://127.0.0.1:9090 when
# running the backend natively (the controller port is published on loopback).
# Changing MIHOMO_* requires recreating the backend container:
#   docker compose up -d --build backend proxy
MIHOMO_CONTROLLER_URL=http://proxy:9090
# Controller API secret. Also passed to the core as CLASH_OVERRIDE_SECRET.
MIHOMO_CONTROLLER_SECRET=
# Latency test target used when pinging nodes.
MIHOMO_TEST_URL=http://www.gstatic.com/generate_204
# Allow importing subscriptions that resolve to private/loopback addresses.
MIHOMO_ALLOW_PRIVATE_SUBSCRIPTION=false
# Directory inside the backend container where the pushed core configuration is
# kept. It is the same volume the proxy container reads (/root/.config/mihomo),
# which is what makes the nodes survive a restart of the core. Leave the compose
# default unless you mount the volume somewhere else.
MIHOMO_CONFIG_DIR=/mihomo-config
# Default mixed port of the core, i.e. the container side of the mapping below.
# Keep it in sync with the port in MIHOMO_MIXED_ADDR.
MIHOMO_MIXED_PORT=7890
# Host port (bound to 127.0.0.1 only) that maps to MIHOMO_MIXED_PORT. Changing
# the port on the proxy page only affects clients inside the docker network;
# to reach the proxy from the host, set both values here and run:
#   docker compose up -d proxy
MIHOMO_PUBLISH_PORT=7890
